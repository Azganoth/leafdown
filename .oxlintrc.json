{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "serviceworker": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "no-var": "error",
    "prefer-const": "error"
  }
}
