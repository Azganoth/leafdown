{
  "name": "leafdown",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:frontend",
    "build:frontend": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "pnpm lint:tsc && pnpm lint:oxlint",
    "lint:backend": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:tsc": "tsc -b",
    "lint:oxlint": "oxlint --type-aware --deny-warnings",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "vitest run",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:frontend && pnpm check:backend",
    "check:frontend": "pnpm check:oxfmt && pnpm lint:frontend && pnpm build && pnpm test:coverage",
    "check:backend": "pnpm check:cargo-fmt && pnpm lint:backend && pnpm test:backend",
    "check:oxfmt": "oxfmt --check",
    "check:cargo-fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format": "pnpm run --parallel /^format:/",
    "format:frontend": "oxfmt",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@milkdown/kit": "7.21.3",
    "@milkdown/plugin-highlight": "7.21.3",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@tauri-store/zustand": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
