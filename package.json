{
  "name": "leafdown",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:frontend",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "pnpm lint:tsc && pnpm lint:oxlint",
    "lint:backend": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:tsc": "tsc -b",
    "lint:oxlint": "oxlint --deny-warnings",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "vitest run",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:frontend && pnpm check:backend",
    "check:frontend": "pnpm check:oxfmt && pnpm lint:frontend && pnpm test:frontend",
    "check:backend": "pnpm check:cargo-fmt && pnpm lint:backend && pnpm test:backend",
    "check:oxfmt": "oxfmt --check",
    "check:cargo-fmt": "cargo +nightly-2026-05-22 fmt --manifest-path src-tauri/Cargo.toml --check",
    "format": "pnpm run --parallel /^format:/",
    "format:frontend": "oxfmt",
    "format:backend": "cargo +nightly-2026-05-22 fmt --manifest-path src-tauri/Cargo.toml",
    "sample": "node --no-warnings scripts/generate-sample.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@milkdown/kit": "7.21.1",
    "@milkdown/plugin-highlight": "7.21.1",
    "@shikijs/langs": "4.1.0",
    "@shikijs/themes": "4.1.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@tauri-store/zustand": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
